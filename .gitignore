# Large raw simulation output (42 MB) — canonical copy is on OSF (DOI 10.17605/OSF.IO/G9WFY).
# Summary tables (mde-table.csv, power-table.csv, theoretical-anchor-candidates.csv,
# simulation-summary.csv) are kept in the repo for at-a-glance review.
simulation-results/simulation-results.csv

# Local logs (but keep component-c run logs as audit anchors)
*.log
!component-c-runs/**/*.log

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS
.DS_Store

# Component C working artifacts: keep small audit anchors (logs, headline
# summaries, null distribution). Skip bulky per-pair and per-benchmark CSVs
# (canonical archives belong on OSF, not git).
component-c-runs/*/*-pairs.csv
component-c-runs/*/*-per-platform.csv
component-c-runs/*/*-per-discipline.csv
component-c-runs/*/*-triples.csv

# Robustness pass: same convention. Keep summary, null, flip-rate, audit
# (small audit anchors). Skip bulky per-pair/triples CSVs.
robustness/**/pairs.csv
robustness/**/flip-rate.pairs.csv
robustness/**/*-triples.csv
